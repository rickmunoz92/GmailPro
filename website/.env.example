# Configure only on the dedicated Gmail Pro Netlify project, Functions scope.
# Keep paid Checkout off throughout free access. The public free build also
# blocks Checkout in code regardless of this flag.
GMAIL_PRO_LAUNCH_ENABLED=false
# Enable only after approved fees, active tax settings/registrations, explicit
# Price tax_behavior and a confirmed Product tax_code; verify a tax calculation.
GMAIL_PRO_AUTOMATIC_TAX_ENABLED=false
GMAIL_PRO_SITE_URL=https://gmail-pro.netlify.app
GMAIL_PRO_STRIPE_ACCOUNT=acct_1UP6cGPINTpCb9YV
GMAIL_PRO_STRIPE_PRODUCT=gmail_pro_subscription
GMAIL_PRO_MONTHLY_PRICE=price_1UW5k4PINTpCb9YVQ4OyNIPJ
GMAIL_PRO_ANNUAL_PRICE=price_1UW5k5PINTpCb9YV5lzgJ40I
GMAIL_PRO_LIVEMODE=true
# Server-only restricted key; permissions are documented in release/README.md.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
# At least 32 random bytes; changing it invalidates all previously issued licenses.
GMAIL_PRO_LICENSE_SECRET=
# Comma-separated Chrome Web Store/unpacked development extension IDs.
GMAIL_PRO_EXTENSION_IDS=
# Optional SHA-256 digest of a temporary review key, plus a UTC expiry timestamp.
GMAIL_PRO_REVIEW_KEY_HASH=
GMAIL_PRO_REVIEW_EXPIRES_AT=
